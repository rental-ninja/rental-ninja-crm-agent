{
  "description": "Auto-approval for the rental-ninja-crm plugin: Hub tools that only read, the low-risk CRM writes (thread assign, state, notes, links, drafts, triage, presence, urgency, company notes) and the Linear lookups run without a prompt. Destructive and grant-gated Hub tools, creating or updating a Linear issue and every other tool always ask. The grant each gated tool needs: skills/hub/SKILL.md, Grants and approvals.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_rental-ninja-crm_hub__(add_company_note|add_thread_note|assign_company_to_thread|assign_thread|change_thread_state|edit_thread_note|explain_rental_config_history|find_config_change|get_activity_log|get_automation_detail|get_booking_contract|get_booking_conversation|get_booking_detail|get_booking_door_codes|get_booking_timeline|get_campaign_results|get_changelog_draft|get_closure_summary|get_company_detail|get_company_feature_usage|get_company_states|get_company_stats|get_company_subscription|get_company_urls|get_dashboard_data|get_guest_detail|get_marketing_context|get_payee_strategy|get_payout_detail|get_pricing_catalogue|get_provider_log|get_rental_detail|get_rental_guides|get_rental_ical_config|get_rental_pictures|get_rental_precheckin_settings|get_rental_rate_calendar|get_rental_upsells|get_sales_funnel|get_settlement_bookings|get_settlement_detail|get_task_detail|get_thread_action_events|get_thread_detail|get_transition_paths|get_upload_url|link_threads|list_automations|list_booking_sources|list_booking_tags|list_campaign_notes|list_campaign_options|list_campaigns|list_changelog_items|list_companies|list_company_feedback|list_company_rentals|list_features|list_key_accounts|list_marketing_assets|list_marketing_audiences|list_marketing_voices|list_mentions|list_missing_translations|list_payees|list_police_registrations|list_settlements|list_smart_devices|list_tasks|list_team_members|list_thread_actions|list_threads|mark_thread_triaged|preview_campaign|preview_marketing_audience|query_payout_summary|query_state_transitions|read_knowledge|recalculate_payout_preview|save_draft|search_bookings|search_changelog|search_closure_summaries|search_companies|search_docs|search_guests|search_guests_by_email|search_provider_logs|search_threads|search_translation_strings|set_thread_presence|set_thread_urgency|suggest_linked_threads|summarize_team_config_activity)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"Auto-approved by the rental-ninja-crm plugin: a read-only or low-risk Hub tool\"}}'"
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_rental-ninja-crm_linear__(get_issue|list_issue_labels|list_projects|list_teams)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"Auto-approved by the rental-ninja-crm plugin: a Linear lookup\"}}'"
          }
        ]
      }
    ]
  }
}
